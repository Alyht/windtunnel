# WINDTUNNEL — model provider (OpenAI-compatible chat completions API)
#
# Copy to .env.local and fill in TENSORMUX_API_KEY to enable the LLM brain.
# The LIVE browser run requires this key and NEVER falls back to a heuristic.
# The committed proof, tests, and `npm run scenarios` remain deterministic and keyless.

TENSORMUX_API_KEY=
TENSORMUX_BASE_URL=https://api.tensormux.com/v1
TENSORMUX_MODEL=glm-4-7-flash

# Which brain the runner uses: "heuristic" (deterministic, default) or "llm".
WINDTUNNEL_BRAIN=heuristic
